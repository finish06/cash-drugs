    {
      "name": "RequestIDMiddleware",
      "file": "internal/middleware/requestid.go",
      "order": 0,
      "purpose": "Outermost middleware. Reads X-Request-ID from inbound request (preserves caller ID) or generates UUID v4. Sets X-Request-ID response header and stores ID in request context for downstream use."
    },
    {
      "name": "GzipMiddleware",
      "file": "internal/middleware/gzip.go",
      "order": 1,
      "purpose": "Compresses responses >= 1KB for compressible content types (JSON, XML). Wraps outermost handler — all routes get gzip."
    },
    {
      "name": "ConcurrencyLimiter",
      "file": "internal/middleware/limiter.go",
      "order": 2,
      "purpose": "Limits in-flight requests via channel semaphore (default 50); returns 503 + Retry-After:1 when full. Exempt: /health, /metrics, /ready. Note: /version is on outer mux so bypasses limiter entirely."
    },
