      "name": "AllowMethods",
      "file": "internal/middleware/methods.go",
      "order": 3,
      "purpose": "Enforces HTTP method restrictions per path prefix. POST-only: /api/warmup, /bulk suffix, /api/test-fetch. GET-only: all other paths. Returns 405 with CD-H004 error code on violation."
    }
